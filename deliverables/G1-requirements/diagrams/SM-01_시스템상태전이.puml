@startuml SM-01_시스템상태전이
title SM-01 시스템 상태(state) 전이\n관련: SWR-003,013,020,021

[*] --> OFF : ignition_on = FALSE (초기값)

OFF --> NORMAL : ignition_on = TRUE\n[SWR-020 역방향]
NORMAL --> OFF : ignition_on = FALSE\n[SWR-020]
DEGRADED --> OFF : ignition_on = FALSE\n[SWR-020]
FAULT --> OFF : ignition_on = FALSE\n[SWR-020]

NORMAL --> DEGRADED : 필수 입력 미갱신 > 200ms\n(100ms 이내 전이) [SWR-013]
DEGRADED --> NORMAL : 입력 freshness 회복\n(설계 단계에서 회복조건 확정)

NORMAL --> FAULT : sensor_fault = TRUE [SWR-021]
DEGRADED --> FAULT : sensor_fault = TRUE [SWR-021]
FAULT --> NORMAL : sensor_fault = FALSE\n(설계 단계에서 회복조건 확정)

state NORMAL {
  NORMAL : 좌/우 출력은 우선순위 체인(AC-01)에 따라 결정
}
state DEGRADED {
  DEGRADED : 필수 입력 무효화, 안전 규칙만 적용
}
state FAULT {
  FAULT : 직전 확정 출력 유지, warning code 제공 [SWR-021]
}
state OFF {
  OFF : 좌/우 출력 = RELEASE [SWR-020]
}

note right of DEGRADED
  회복(DEGRADED→NORMAL) 및
  FAULT→NORMAL 전이조건의 세부 확정은
  OEM 문서에 명시되지 않아 설계 단계
  확인 필요 항목으로 별도 보고함.
end note

@enduml
